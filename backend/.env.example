# ---------------------------------------------------------------- exécution
NODE_ENV=development
PORT=4000

# ---------------------------------------------------------------- base de données
# Local (docker compose up -d) :
DATABASE_URL="postgresql://stihl:stihl@localhost:5432/dravik?schema=public"
# Railway : la variable est injectée automatiquement, utilisez ${{Postgres.DATABASE_URL}}

# ---------------------------------------------------------------- authentification
# Générez chaque secret avec : openssl rand -base64 48
JWT_ACCESS_SECRET="remplacez-moi-par-48-octets-aleatoires-minimum-32-caracteres"
JWT_REFRESH_SECRET="remplacez-moi-aussi-par-une-autre-valeur-aleatoire-differente"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ---------------------------------------------------------------- CORS / frontend
# Origines autorisées, séparées par des virgules (sans slash final)
CORS_ORIGINS="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# ---------------------------------------------------------------- Stripe (optionnel)
# Laissez vide pour désactiver le paiement carte : seul le virement sera proposé.
# Clés de test : https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Obtenu via : stripe listen --forward-to localhost:4000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------- virement SEPA
# Coordonnées affichées au client sur la page de confirmation de commande.
BANK_ACCOUNT_HOLDER="Dravik SAS"
BANK_IBAN="FR7630001007941234567890185"
BANK_BIC="BDFEFRPPCCT"
BANK_NAME="Banque de démonstration"
BANK_TRANSFER_DUE_DAYS=7

# ---------------------------------------------------------------- compte admin (seed)
ADMIN_EMAIL="admin@dravik.eu"
ADMIN_PASSWORD="ChangeMoi!2026"

# ---------------------------------------------------------------- e-mail
# Un seul canal : formulaire de contact, justificatifs de virement recus et
# messages de suivi envoyes au client a chaque etape passent par ce SMTP.
# Laissez vide en local : rien ne part, le formulaire de contact est masque
# et les avis de suivi sont journalises avec leur motif d'echec.
#
# N'importe quel SMTP convient. Attention a l'adresse de MAIL_FROM : si son
# domaine n'autorise pas le relais utilise, SPF echoue et les messages
# partent en indesirables.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
# Boite qui recoit les justificatifs et les messages de contact.
# A defaut, MAIL_USER.
MAIL_TO_SHOP=
